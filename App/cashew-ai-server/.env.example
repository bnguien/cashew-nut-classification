# =============================================================================
# cashew-ai-server — .env.example
# DO NOT put real secrets here. Copy to .env and fill in actual values.
# =============================================================================

DJANGO_SECRET_KEY=change_me_before_deploy
DJANGO_DEBUG=True
ALLOWED_HOSTS=*
MOCK_MODE=false

# Model selection — change MODEL_PATH + MODEL_VERSION to swap models.
# MODEL_TYPE: auto | yolo | tflite  (auto detects from file extension)
MODEL_PATH=./models/final_mobilenetv2_cashew.tflite
MODEL_VERSION=cashew-mobilenetv2-v1
MODEL_TYPE=auto

# Confidence threshold
AI_MIN_CONFIDENCE=0.40

# YOLO settings (ignored when using TFLite)
AI_IMGSZ=640
AI_HALF=false

# TFLite settings (ignored when using YOLO)
AI_TFLITE_INPUT_SIZE=224
AI_TFLITE_CLASSES=whole,broken,defect

# Annotation default
AI_RETURN_ANNOTATED_IMAGE_DEFAULT=true
